# App
APP_BASE_URL=https://your-domain.com

# Stripe secret values — keep these only on the server / Vercel environment
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_DAILY=price_xxx_daily_monthly
STRIPE_PRICE_PRO=price_xxx_pro_monthly
STRIPE_PRICE_INSTITUTION=price_xxx_institution_monthly
STRIPE_PRICE_LIFETIME=price_xxx_lifetime_once

# Supabase server values — never expose the service role key in browser code
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public Supabase values for browser login UI
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key
